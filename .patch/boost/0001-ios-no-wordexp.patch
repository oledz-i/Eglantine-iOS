From: oledz-i
Subject: [PATCH] process: no wordexp on iOS

---
--- a/libs/process/src/shell.cpp	2026-11-02 07:06:00.358931805 -0500
+++ b/libs/process/src/shell.cpp	2026-11-02 07:06:00.383041545 -0500
@@ -9,6 +9,14 @@
 #include <boost/asio/windows/basic_object_handle.hpp>
 #endif
 
+// wordexp is marked unavailable on iOS; take the same path as Android.
+#if defined(__APPLE__)
+#include <TargetConditionals.h>
+#endif
+#if defined(__ANDROID__) || (defined(TARGET_OS_IPHONE) && TARGET_OS_IPHONE)
+#define BOOST_PROCESS_V2_NO_WORDEXP 1
+#endif
+
 
 #include <boost/process/v2/detail/last_error.hpp>
 #include <boost/process/v2/detail/throw_error.hpp>
@@ -19,7 +27,7 @@
 #if defined(BOOST_PROCESS_V2_WINDOWS)
 #include <windows.h>
 #include <shellapi.h>
-#elif !defined(__OpenBSD__) && !defined(__ANDROID__)
+#elif !defined(__OpenBSD__) && !defined(BOOST_PROCESS_V2_NO_WORDEXP)
 #include <wordexp.h>
 #endif
 
@@ -30,7 +38,7 @@
 {
     return system_category();
 }
-#elif !defined(__OpenBSD__) && !defined(__ANDROID__)
+#elif !defined(__OpenBSD__) && !defined(BOOST_PROCESS_V2_NO_WORDEXP)
 
 struct shell_category_t final : public error_category
 {
@@ -99,7 +107,7 @@
     return input_.c_str();
 }
 
-#elif !defined(__OpenBSD__) && !defined(__ANDROID__)
+#elif !defined(__OpenBSD__) && !defined(BOOST_PROCESS_V2_NO_WORDEXP)
 
 void shell::parse_()
 {
